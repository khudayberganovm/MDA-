# --- Core ---
NODE_ENV=development
PORT=8080
# Public HTTPS URL of this server (Mini App + download links). Telegram requires HTTPS for Mini Apps.
PUBLIC_URL=http://localhost:8080
DATABASE_URL="file:./dev.db"
MEDIA_DIR=./media
# Secret for signing download links (any long random string)
APP_SECRET=change-me-to-a-long-random-string

# --- Telegram ---
BOT_TOKEN=
# HTTPS URL that opens the Mini App (usually PUBLIC_URL)
WEBAPP_URL=

# --- Dev/demo ---
# Local dev auth (header "Authorization: dev <telegramId>"). Refused when NODE_ENV=production.
DEV_AUTH=true
# Use built-in demo script + demo narration when AI keys are missing. Output is labelled DEMO.
DEMO_MODE=true

# --- Paid providers: only called when key is set AND ENABLE_PAID_APIS=true ---
ENABLE_PAID_APIS=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
PEXELS_API_KEY=
ELEVENLABS_API_KEY=
# Verify language support for your model at elevenlabs.io/docs/models before use.
ELEVENLABS_MODEL_UZ=eleven_v3
ELEVENLABS_MODEL_RU=eleven_multilingual_v2
ELEVENLABS_VOICE_UZ_MALE=
ELEVENLABS_VOICE_UZ_FEMALE=
ELEVENLABS_VOICE_RU_MALE=
ELEVENLABS_VOICE_RU_FEMALE=

# --- Limits ---
MAX_PROJECTS_PER_DAY=10
MAX_ACTIVE_JOBS_PER_USER=2
MAX_JOB_RETRIES=2
RENDER_CONCURRENCY=2
RENDER_TIMEOUT_MS=900000
KEEP_OUTPUT_DAYS=14

# Optional: pre-installed Chrome Headless Shell binary (otherwise Remotion downloads it on first render)
BROWSER_EXECUTABLE=
