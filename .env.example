# --- Core ---
NODE_ENV=development
PORT=8080
# Public HTTPS URL of this server (Mini App, file links, payment callbacks).
PUBLIC_URL=http://localhost:8080
DATABASE_URL="file:./dev.db"
MEDIA_DIR=./media
# Secret for signing file links (long random string)
APP_SECRET=change-me-to-a-long-random-string

# --- Telegram ---
BOT_TOKEN=
# HTTPS URL that opens the Mini App (usually PUBLIC_URL)
WEBAPP_URL=
# Admin Telegram IDs, comma separated (open the bot and send /myid)
ADMIN_IDS=
# Team group that receives orders: add the bot to the group, send /chatid there
ADMIN_CHAT_ID=
# Support username shown to clients (without @)
SUPPORT_USERNAME=
REVISIONS_PER_ORDER=2

# --- Payments (a method is shown only when it is configured) ---
# Payme Merchant API. Endpoint for the Payme cabinet: https://<domain>/pay/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=false
# Click SHOP API. Prepare: https://<domain>/pay/click/prepare  Complete: https://<domain>/pay/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Manual card transfer (admin confirms in the group). Use \n for new lines.
MANUAL_PAY_INFO=

# --- Local development only ---
# Dev auth header "Authorization: dev <telegramId>" + test payments. Refused when NODE_ENV=production.
DEV_AUTH=true
